# Include your custom HAL commands here
# This file will not be overwritten when you run PNCconf again

loadrt estop_latch
addf estop-latch.0 servo-thread

loadrt oneshot count=1
addf oneshot.0 servo-thread
setp oneshot.0.width 0.5    # trigger for half second to allow soft reset of drives

loadrt or2 names=or.probeortls
addf or.probeortls servo-thread

# =========================================================
# Shared Software Debounce Filtering (cfg=6 Channels total)
# =========================================================

loadrt debounce cfg=6
addf debounce.0 servo-thread
setp debounce.0.delay 20

# Safely break the noisy raw inputs away from your main HAL file signals
unlinkp hm2_7i96s.0.inm.00.input-00-not
unlinkp hm2_7i96s.0.inm.00.input-01-not
unlinkp hm2_7i96s.0.inm.00.input-02-not
unlinkp hm2_7i96s.0.inm.00.input-03-not

# Feed the raw Mesa inputs directly into the new debounce filter channels
net raw-limit-x  <= hm2_7i96s.0.inm.00.input-00-not => debounce.0.1.in
net raw-limit-y  <= hm2_7i96s.0.inm.00.input-01-not => debounce.0.2.in
net raw-limit-z  <= hm2_7i96s.0.inm.00.input-02-not => debounce.0.3.in
net raw-limit-y2 <= hm2_7i96s.0.inm.00.input-03-not => debounce.0.4.in

# Route the beautifully cleaned debounce outputs back into your machine nets
net max-home-x   <= debounce.0.1.out
net max-home-y   <= debounce.0.2.out
net max-home-z   <= debounce.0.3.out
net max-home-y2  <= debounce.0.4.out

# --- Shared halui components ---
# for xhc-whb04b-6 pendant and Probe basic

net prog-running <= halui.program.is-idle
net prog-paused <= halui.program.is-paused

# --- ESTOP Chain ---

net estop-loopout iocontrol.0.emc-enable-in <= estop-latch.0.ok-out
net estop-loopin iocontrol.0.user-enable-out => estop-latch.0.ok-in
net estop-reset iocontrol.0.user-request-enable => estop-latch.0.reset
#net remote-estop => estop-latch.0.reset

net remote-estop estop-latch.0.fault-in <=  hm2_7i96s.0.inm.00.input-10-not

# --- ESTOP Chain End ---

# --- Probe / TLS ---

# --- PROBE-IN ---
net probe-in	<=	hm2_7i96s.0.inm.00.input-05  =>	or.probeortls.in0

# --- TLS-Normal-IN ---
net tls-in	<=	hm2_7i96s.0.inm.00.input-07  =>	or.probeortls.in1

net debounceProbeTSin debounce.0.0.in	<=	or.probeortls.out
net probe-out debounce.0.0.out	=>	motion.probe-input

# =========================================================
# Debounced Tool Setter Max Over-Travel Switch (Joint 3 Noise Fix)
# =========================================================
net raw-tool-max <= hm2_7i96s.0.inm.00.input-08-not => debounce.0.5.in
net tool-max     <= debounce.0.5.out                => joint.3.neg-lim-sw-in


# --- Tool Setter Air ---
net tool-air => hm2_7i96s.0.ssr.00.out-02

# --- Drive ALM ---

# Handle drive alarm with oneshot to allow reset via soft reset
net drive-alarm-in oneshot.0.in <= hm2_7i96s.0.inm.00.input-06
net drive-alarm-out oneshot.0.out => joint.0.amp-fault-in   #trigger a drive alarm - X
net drive-alarm-out => joint.1.amp-fault-in                 #trigger a drive alarm - Y
net drive-alarm-out => joint.2.amp-fault-in                 #trigger a drive alarm - Y2
net drive-alarm-out => joint.3.amp-fault-in                 #trigger a drive alarm - Z
